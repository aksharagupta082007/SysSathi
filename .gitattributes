# Set default behaviour to automatically normalize line endings to LF.
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.py text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Denote all binary files
*.png binary
*.jpg binary
*.wav binary
*.ico binary

